<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- controleert dagelijks of devices zijn verlopen (en past het aan) -->
    <record id="ir_cron_disable_expired_devices" model="ir.cron">
        <field name="name">Disable Expired Devices</field>
        <field name="model_id" ref="model_system_b_device"/>
        <field name="state">code</field>
        <field name="code">model.disable_expired_devices()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

      <!-- controleert dagelijks of content is verlopen (en past het aan)-->
    <record id="ir_cron_disable_expired_content" model="ir.cron">
        <field name="name">Disable Expired Content</field>
        <field name="model_id" ref="model_system_b_content"/>
        <field name="state">code</field>
        <field name="code">model.disable_expired_content()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!--Voert dagelijks het ophalen/aanpassen van de devices en content CSV's uit van de map dat is ingesteld-->
    <record id="ir_cron_import_csv_delivery" model="ir.cron">
        <field name="name">Import Signage CSV Delivery</field>
        <field name="model_id" ref="model_system_b_csv_import"/>
        <field name="state">code</field>
        <field name="code">model._import_delivery()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
