<odoo>
    <!-- Lijstweergave van content -->
    <record id="view_system_b_content_list" model="ir.ui.view">
        <field name="name">system_b.content.list</field>
        <field name="model">system_b.content</field>
        <field name="arch" type="xml">
            <list string="Content" create="false" edit="false" delete="false">
                <field name="content_id"/>
                <field name="name"/>
                <field name="description"/>
                <field name="device_id"/>
                <field name="expire_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Formulierweergave van content -->
    <record id="view_system_b_content_form" model="ir.ui.view">
        <field name="name">system_b.content.form</field>
        <field name="model">system_b.content</field>
        <field name="arch" type="xml">
            <form string="Content" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="content_id"/>
                            <field name="name"/>
                            <field name="device_id"/>
                        </group>
                        <group>
                            <field name="expire_date"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actie -->
    <record id="action_system_b_content" model="ir.actions.act_window">
        <field name="name">Content</field>
        <field name="res_model">system_b.content</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>