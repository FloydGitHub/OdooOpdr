<odoo>
    <!-- Lijstweergave van apparaten -->
    <record id="view_system_b_device_list" model="ir.ui.view">
        <field name="name">system_b.device.list</field>
        <field name="model">system_b.device</field>
        <field name="arch" type="xml">
            <list string="Devices" create="false" edit="false" delete="false">
                <field name="device_id"/>
                <field name="name"/>
                <field name="description"/>
                <field name="code"/>
                <field name="expire_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Formulierweergave van een apparaat -->
    <record id="view_system_b_device_form" model="ir.ui.view">
        <field name="name">system_b.device.form</field>
        <field name="model">system_b.device</field>
        <field name="arch" type="xml">
            <form string="Device" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="device_id"/>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="expire_date"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actie -->
    <record id="action_system_b_device" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">system_b.device</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>