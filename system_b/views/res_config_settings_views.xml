<odoo>
    <record id="res_config_settings_view_form_system_b" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.system.b</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="System B" name="system_b">
                    <block title="CSV Import">
                        <setting string="CSV Folder Path">
                            <field name="csv_folder_path"/>
                        </setting>
                        <setting string="CSV Delimiter">
                            <field name="csv_delimiter"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>