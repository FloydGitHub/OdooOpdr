<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ir_cron_disable_expired_devices" model="ir.cron">
        <field name="name">Disable Expired Devices</field>
        <field name="model_id" ref="model_system_b_device"/>
        <field name="state">code</field>
        <field name="code">model.disable_experired_devices()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_disable_expired_content" model="ir.cron">
        <field name="name">Disable Expired Content</field>
        <field name="model_id" ref="model_system_b_content"/>
        <field name="state">code</field>
        <field name="code">model.disable_experired_content()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
